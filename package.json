{
  "name": "gatewarden",
  "productName": "Gatewarden",
  "version": "0.7.0",
  "description": "Gatewarden: hordes from every side, one hero, hold the Gate.",
  "main": "main.js",
  "author": "YOUR_STUDIO_NAME",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "check:release": "node scripts/check.js --release",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac --universal",
    "dist": "npm run check && electron-builder --x64"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.yourstudio.gatewarden",
    "productName": "Gatewarden",
    "copyright": "Copyright \u00a9 2026 YOUR_STUDIO_NAME",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "steam.config.json",
      "game/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "Gatewarden"
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "gatewarden"
    },
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "publish": null
  }
}